{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "ConversorPDF.XLL.dll"
          ],
          "src": "../ConversorPDF.XLL/bin/x64/Release"
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "ESAP - ConversorPDF",
      "_appFooter": "ESAP - ConversorPDF Doc",
      "_enableSearch": true,
      "_appLogoPath": "images/logo.png",
      "_language": "es"
    },
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "noDefaultExcludes": false
  }
}
